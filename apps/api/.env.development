# ──────────────────────────────────────────────────────────────
# DEVELOPMENT environment — used when running locally via Docker
# Safe to commit defaults here since these are LOCAL-ONLY secrets.
# Copy this file to `.env` to run locally: cp .env.development .env
# ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Local Postgres (spun up by docker-compose.dev.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=knockit
DB_PASSWORD=knockit_dev_password
DB_DATABASE=knockit_crm_dev
DB_SSL=false

# Local Redis (spun up by docker-compose.dev.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — dev-only secrets, NEVER reuse these in staging/production
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_make_long_random
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_make_long_random
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

FRONTEND_URL=http://localhost:5173

# Email — leave RESEND_API_KEY empty in dev to log emails to console instead of sending
RESEND_API_KEY=
EMAIL_FROM=Knockit Technologies <dev@knockit.local>

# File storage — point at local MinIO (S3-compatible) container in dev
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=knockit-dev-local

# Pusher (real-time) — leave blank in dev, falls back to console logging
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
