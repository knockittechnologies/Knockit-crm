# ──────────────────────────────────────────────────────────────
# PRODUCTION environment — template only.
# Real values come from AWS Secrets Manager, injected by ECS task
# definition at container start. This file is documentation, not config.
# ──────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

DB_HOST=__INJECTED_AT_DEPLOY__
DB_PORT=5432
DB_USERNAME=__INJECTED_AT_DEPLOY__
DB_PASSWORD=__INJECTED_AT_DEPLOY__
DB_DATABASE=knockit_crm_production
DB_SSL=true

REDIS_HOST=__INJECTED_AT_DEPLOY__
REDIS_PORT=6379
REDIS_PASSWORD=__INJECTED_AT_DEPLOY__

JWT_ACCESS_SECRET=__INJECTED_AT_DEPLOY__
JWT_REFRESH_SECRET=__INJECTED_AT_DEPLOY__
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

FRONTEND_URL=https://app.knockit.co.uk

RESEND_API_KEY=__INJECTED_AT_DEPLOY__
EMAIL_FROM=Knockit Technologies <noreply@knockit.co.uk>

AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=__USES_ECS_TASK_ROLE_NOT_KEYS__
AWS_SECRET_ACCESS_KEY=__USES_ECS_TASK_ROLE_NOT_KEYS__
S3_BUCKET=knockit-production-files

PUSHER_APP_ID=__INJECTED_AT_DEPLOY__
PUSHER_KEY=__INJECTED_AT_DEPLOY__
PUSHER_SECRET=__INJECTED_AT_DEPLOY__
PUSHER_CLUSTER=eu
