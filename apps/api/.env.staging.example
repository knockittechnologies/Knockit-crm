# ──────────────────────────────────────────────────────────────
# STAGING environment — template only.
# Real values are injected at deploy time via GitHub Actions secrets
# / AWS Secrets Manager. NEVER commit real staging secrets to git.
# This file documents WHICH variables staging needs.
# ──────────────────────────────────────────────────────────────

NODE_ENV=staging
PORT=3000

# AWS RDS staging instance (see infra/terraform)
DB_HOST=__INJECTED_AT_DEPLOY__
DB_PORT=5432
DB_USERNAME=__INJECTED_AT_DEPLOY__
DB_PASSWORD=__INJECTED_AT_DEPLOY__
DB_DATABASE=knockit_crm_staging
DB_SSL=true

# AWS ElastiCache (Redis) staging instance
REDIS_HOST=__INJECTED_AT_DEPLOY__
REDIS_PORT=6379
REDIS_PASSWORD=__INJECTED_AT_DEPLOY__

# JWT — long random secrets stored in AWS Secrets Manager
JWT_ACCESS_SECRET=__INJECTED_AT_DEPLOY__
JWT_REFRESH_SECRET=__INJECTED_AT_DEPLOY__
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

FRONTEND_URL=https://staging.knockit.app

RESEND_API_KEY=__INJECTED_AT_DEPLOY__
EMAIL_FROM=Knockit Technologies <noreply@staging.knockit.app>

AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=__USES_ECS_TASK_ROLE_NOT_KEYS__
AWS_SECRET_ACCESS_KEY=__USES_ECS_TASK_ROLE_NOT_KEYS__
S3_BUCKET=knockit-staging-files

PUSHER_APP_ID=__INJECTED_AT_DEPLOY__
PUSHER_KEY=__INJECTED_AT_DEPLOY__
PUSHER_SECRET=__INJECTED_AT_DEPLOY__
PUSHER_CLUSTER=eu
